<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.12.0</Version>
    <AbiVersion>1.0.0.0</AbiVersion>
    <HostContractName>SpatialViewer.CadHost</HostContractName>
    <HostContractMinVersion>1.0.0</HostContractMinVersion>
    <HostContractMaxVersionExclusive>2.0.0</HostContractMaxVersionExclusive>
    <ReleaseManifestSchemaVersion>2</ReleaseManifestSchemaVersion>
    <AssemblyVersion>$(AbiVersion)</AssemblyVersion>
    <FileVersion>0.12.0.0</FileVersion>
    <InformationalVersion>0.12.0</InformationalVersion>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
